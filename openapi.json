{
    "openapi": "3.1.0",
    "info": {
        "title": "FraudNova API",
        "version": "1.0.0",
        "description": "Real-time fraud scoring for IP addresses, email addresses, and phone numbers. Authenticate with your API key as a Bearer token (fn_...)."
    },
    "servers": [
        {
            "url": "https://fraudnova.com"
        }
    ],
    "security": [
        {
            "bearerAuth": []
        }
    ],
    "paths": {
        "/api/v1/check": {
            "get": {
                "summary": "Score a single IP",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "ip",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "description": "IPv4/IPv6 address to score"
                    },
                    {
                        "name": "strictness",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 3,
                            "default": 2
                        }
                    },
                    {
                        "name": "mobile",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "user_agent",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "user_language",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Score result",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/CheckData"
                                        },
                                        "credits_remaining": {
                                            "type": "integer"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid or missing API token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "402": {
                        "description": "Insufficient credits",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid input",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "Upstream unavailable",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/check/email": {
            "get": {
                "summary": "Score a single email address",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "email",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "description": "Email address to score"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Score result",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/EmailCheckData"
                                        },
                                        "credits_remaining": {
                                            "type": "integer"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid or missing API token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "402": {
                        "description": "Insufficient credits",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid input",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "Upstream unavailable",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/check/phone": {
            "get": {
                "summary": "Score a single phone number",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "phone",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "description": "Phone number to score"
                    },
                    {
                        "name": "country",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "description": "ISO-3166 alpha-2 country hint, e.g. US"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Score result",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/PhoneCheckData"
                                        },
                                        "credits_remaining": {
                                            "type": "integer"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid or missing API token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "402": {
                        "description": "Insufficient credits",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid input",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "Upstream unavailable",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/check/batch": {
            "post": {
                "summary": "Score up to 100 IPs in one request",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "ips"
                                ],
                                "properties": {
                                    "ips": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "minItems": 1,
                                        "maxItems": 100
                                    },
                                    "strictness": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 3
                                    },
                                    "mobile": {
                                        "type": "boolean"
                                    },
                                    "user_agent": {
                                        "type": "string"
                                    },
                                    "user_language": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Per-IP results",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "results": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/BatchResultItem"
                                            }
                                        },
                                        "credits_remaining": {
                                            "type": "integer"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid or missing API token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "402": {
                        "description": "Insufficient credits (balance was zero)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid envelope",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/check/email/batch": {
            "post": {
                "summary": "Score up to 100 emails in one request",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "emails"
                                ],
                                "properties": {
                                    "emails": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "minItems": 1,
                                        "maxItems": 100
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Per-email results",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "results": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/BatchEmailResultItem"
                                            }
                                        },
                                        "credits_remaining": {
                                            "type": "integer"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid or missing API token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "402": {
                        "description": "Insufficient credits (balance was zero)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid envelope",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/check/phone/batch": {
            "post": {
                "summary": "Score up to 100 phone numbers in one request",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "phones"
                                ],
                                "properties": {
                                    "phones": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "minItems": 1,
                                        "maxItems": 100
                                    },
                                    "country": {
                                        "type": "string",
                                        "description": "ISO-3166 alpha-2 country hint applied to the whole batch, e.g. US"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Per-phone results",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "results": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/BatchPhoneResultItem"
                                            }
                                        },
                                        "credits_remaining": {
                                            "type": "integer"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid or missing API token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "402": {
                        "description": "Insufficient credits (balance was zero)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid envelope",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/balance": {
            "get": {
                "summary": "Return the current credit balance (free, does not consume a credit)",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Current balance",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "credits_remaining": {
                                            "type": "integer"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/my-ip": {
            "get": {
                "summary": "Return the caller's IP (free, no auth)",
                "security": [],
                "responses": {
                    "200": {
                        "description": "Caller IP",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "ip": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "description": "API key as a Bearer token (fn_...)"
            }
        },
        "schemas": {
            "CheckData": {
                "type": "object",
                "properties": {
                    "fraud_score": {
                        "type": "integer"
                    },
                    "proxy": {
                        "type": "boolean"
                    },
                    "vpn": {
                        "type": "boolean"
                    },
                    "tor": {
                        "type": "boolean"
                    },
                    "active_vpn": {
                        "type": "boolean"
                    },
                    "active_tor": {
                        "type": "boolean"
                    },
                    "recent_abuse": {
                        "type": "boolean"
                    },
                    "bot_status": {
                        "type": "boolean"
                    },
                    "country_code": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "region": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "city": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "ISP": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "organization": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "ASN": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    },
                    "operating_system": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "browser": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "device_brand": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "device_model": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                }
            },
            "EmailCheckData": {
                "type": "object",
                "properties": {
                    "valid": {
                        "type": "boolean"
                    },
                    "fraud_score": {
                        "type": "integer"
                    },
                    "disposable": {
                        "type": "boolean"
                    },
                    "deliverability": {
                        "type": "string"
                    },
                    "smtp_score": {
                        "type": "integer"
                    },
                    "overall_score": {
                        "type": "integer"
                    },
                    "catch_all": {
                        "type": "boolean"
                    },
                    "generic": {
                        "type": "boolean"
                    },
                    "common": {
                        "type": "boolean"
                    },
                    "dns_valid": {
                        "type": "boolean"
                    },
                    "honeypot": {
                        "type": "boolean"
                    },
                    "frequent_complainer": {
                        "type": "boolean"
                    },
                    "suspect": {
                        "type": "boolean"
                    },
                    "recent_abuse": {
                        "type": "boolean"
                    },
                    "leaked": {
                        "type": "boolean"
                    },
                    "spam_trap_score": {
                        "type": "string"
                    },
                    "risky_tld": {
                        "type": "boolean"
                    },
                    "spf_record": {
                        "type": "boolean"
                    },
                    "dmarc_record": {
                        "type": "boolean"
                    },
                    "first_seen": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "domain_age": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "result_type": {
                        "type": "string"
                    },
                    "sanitized_email": {
                        "type": "string"
                    }
                }
            },
            "PhoneCheckData": {
                "type": "object",
                "properties": {
                    "valid": {
                        "type": "boolean"
                    },
                    "fraud_score": {
                        "type": "integer"
                    },
                    "recent_abuse": {
                        "type": "boolean"
                    },
                    "VOIP": {
                        "type": "boolean"
                    },
                    "prepaid": {
                        "type": "boolean"
                    },
                    "risky": {
                        "type": "boolean"
                    },
                    "active": {
                        "type": "boolean"
                    },
                    "carrier": {
                        "type": "string"
                    },
                    "line_type": {
                        "type": "string"
                    },
                    "country": {
                        "type": "string"
                    },
                    "region": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "timezone": {
                        "type": "string"
                    },
                    "zip_code": {
                        "type": "string"
                    },
                    "dialing_code": {
                        "type": "integer"
                    },
                    "do_not_call": {
                        "type": "boolean"
                    },
                    "leaked": {
                        "type": "boolean"
                    },
                    "spammer": {
                        "type": "boolean"
                    },
                    "active_status": {
                        "type": "string"
                    },
                    "formatted": {
                        "type": "string"
                    },
                    "local_format": {
                        "type": "string"
                    }
                }
            },
            "BatchResultItem": {
                "type": "object",
                "properties": {
                    "ip": {
                        "type": "string"
                    },
                    "success": {
                        "type": "boolean"
                    },
                    "data": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/CheckData"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "error": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "enum": [
                            "invalid_ip",
                            "insufficient_credits",
                            "upstream_failed",
                            null
                        ]
                    }
                }
            },
            "BatchEmailResultItem": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "success": {
                        "type": "boolean"
                    },
                    "data": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/EmailCheckData"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "error": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "enum": [
                            "invalid_email",
                            "insufficient_credits",
                            "upstream_failed",
                            null
                        ]
                    }
                }
            },
            "BatchPhoneResultItem": {
                "type": "object",
                "properties": {
                    "phone": {
                        "type": "string"
                    },
                    "success": {
                        "type": "boolean"
                    },
                    "data": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/PhoneCheckData"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "error": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "enum": [
                            "invalid_phone",
                            "insufficient_credits",
                            "upstream_failed",
                            null
                        ]
                    }
                }
            },
            "ErrorResponse": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "enum": [
                            false
                        ]
                    },
                    "message": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
