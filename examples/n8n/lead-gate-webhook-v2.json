      "parameters": {
        "jsCode": "// Reads the three FraudNova results, keeps the highest score, collects reasons\n// and picks accept / review / reject. Any failure here still ends in \"review\".\ntry {\n  const settings = $('Settings').first().json;\n  const lead = $('Normalize lead').first().json;\n  const reviewAt = Number(settings.review_at);\n  const rejectAt = Number(settings.reject_at);\n  const rejectFlags = String(settings.reject_flags || '')\n    .split(',').map((s) => s.trim().toLowerCase()).filter(Boolean);\n\n  // Each FraudNova node outputs one item that carries its subject key (ip / email / phone),\n  // also when the check failed (then it has an `error` field instead of scores).\n  const results = { ip: null, email: null, phone: null };\n  for (const item of $input.all()) {\n    const j = item.json || {};\n    for (const type of ['ip', 'email', 'phone']) {\n      if (Object.prototype.hasOwnProperty.call(j, type)) { results[type] = j; break; }\n    }\n  }\n\n  // API field -> reason name. Phone uses upper-case VOIP in the API.\n  const FLAGS = {\n    ip: { proxy: 'proxy', vpn: 'vpn', tor: 'tor', bot_status: 'bot', recent_abuse: 'recent_abuse' },\n    email: { disposable: 'disposable', honeypot: 'honeypot', recent_abuse: 'recent_abuse' },\n    phone: { VOIP: 'voip', risky: 'risky_phone', recent_abuse: 'recent_abuse' },\n  };\n\n  const reasons = [];\n  const failed = [];\n  const skipped = [];\n  const scores = { ip: null, email: null, phone: null };\n\n  for (const type of ['ip', 'email', 'phone']) {\n    if (!lead[type]) { skipped.push(type); continue; }        // nothing submitted, nothing to check\n    const r = results[type];\n    if (!r || r.error !== undefined) { failed.push(type); continue; } // 402 / 429 / 503 / timeout\n    if (typeof r.fraud_score === 'number') scores[type] = r.fraud_score;\n    for (const [field, reason] of Object.entries(FLAGS[type])) {\n      if (r[field] === true) reasons.push(reason);\n    }\n    if (type !== 'ip' && r.valid === false) reasons.push(type === 'email' ? 'invalid_email' : 'invalid_phone');\n  }\n\n  const checked = ['ip', 'email', 'phone'].filter((t) => !skipped.includes(t));\n  const known = Object.values(scores).filter((v) => typeof v === 'number');\n  const maxScore = known.length ? Math.max(...known) : null;\n\n  let decision = 'accept';\n  if (reasons.length) decision = 'review';                              // any flag gets a human look\n  if (maxScore !== null && maxScore >= reviewAt) decision = 'review';\n  if (failed.length) { reasons.push('check_failed'); decision = 'review'; } // fail open to a human, never a silent accept\n  if (checked.length === 0) { reasons.push('nothing_to_check'); decision = 'review'; }\n  if (reasons.some((r) => rejectFlags.includes(r))) decision = 'reject';\n  if (maxScore !== null && maxScore >= rejectAt) decision = 'reject';\n\n  const unique = [...new Set(reasons)];\n  const ip = results.ip && results.ip.error === undefined ? results.ip : {};\n  const email = results.email && results.email.error === undefined ? results.email : {};\n  const phone = results.phone && results.phone.error === undefined ? results.phone : {};\n\n  return [{ json: {\n    ...lead,\n    decision,\n    max_score: maxScore,\n    reasons: unique,\n    reasons_text: unique.join(', ') || 'none',\n    scores,\n    checks_failed: failed,\n    checks_skipped: skipped,\n    all_checks_failed: checked.length > 0 && failed.length === checked.length,\n    ip_country: ip.country_code || '',\n    ip_isp: ip.ISP || '',\n    email_valid: typeof email.valid === 'boolean' ? email.valid : null,\n    email_deliverability: email.deliverability || '',\n    phone_valid: typeof phone.valid === 'boolean' ? phone.valid : null,\n    phone_line_type: phone.line_type || '',\n    phone_carrier: phone.carrier || '',\n    review_at: reviewAt,\n    reject_at: rejectAt,\n    decided_at: new Date().toISOString(),\n  } }];\n} catch (error) {\n  // A bug in this node must not drop the lead: hold it for review and say why.\n  const lead = $('Normalize lead').first().json;\n  return [{ json: {\n    ...lead,\n    decision: 'review',\n    max_score: null,\n    reasons: ['decide_error'],\n    reasons_text: 'decide_error: ' + (error && error.message ? error.message : String(error)),\n    scores: { ip: null, email: null, phone: null },\n    checks_failed: [],\n    checks_skipped: [],\n    all_checks_failed: false,\n    decided_at: new Date().toISOString(),\n  } }];\n}\n"
      },
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        480
      ]
